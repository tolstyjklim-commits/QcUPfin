# Адрес бэкенда: включает автовыгрузку подарков Telegram и цен NFT
VITE_API_URL=http://localhost:4000

# Пополнение без бэкенда (GitHub Pages): сайт сам проверяет платежи через toncenter
VITE_TON_ADDRESS=
VITE_TONCENTER_KEY=
VITE_COINS_PER_TON=150
VITE_COINS_PER_USDT=100

# Запасные значения курса, если рыночные источники недоступны (1 монета = 1 Star)
VITE_STAR_USD=0.015
VITE_TON_USD=

# Вход через Telegram: ссылка на мини-приложение для кнопки «Открыть в Telegram» (например https://t.me/ваш_бот/app)
VITE_BOT_URL=
# Только для разработки: 1 = пускать без Telegram
VITE_AUTH_OFF=
