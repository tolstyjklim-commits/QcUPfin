TELEGRAM_BOT_TOKEN=replace_me
DATABASE_URL=postgresql://qcup:qcup_local_password@localhost:5432/qcup?schema=public
API_PORT=4000

# NFT-подарки: ключ Gift Asset API (получить у @giftasset_api_tokens_bot) и шаблон картинок коллекций
GIFTASSET_API_KEY=
NFT_IMAGE_TEMPLATE=

# Бот: плашка с кнопкой запуска на /start. WEBAPP_URL должен быть HTTPS (для теста: ngrok или cloudflared)
WEBAPP_URL=
BOT_BUTTON_TEXT=🎮 Играть
BOT_WELCOME_TEXT=
BOT_WELCOME_IMAGE=

# 0 = не запускать бота локально (если бот работает через GitHub Actions, см. bot-repo)
BOT_ENABLED=1

# Пополнение TON: адрес вашего кошелька (получатель), ключ toncenter (https://t.me/tonapibot) и курс
TON_DEPOSIT_ADDRESS=
TONCENTER_API_KEY=
COINS_PER_TON=150
MIN_DEPOSIT_TON=0.1
MAX_DEPOSIT_TON=1000
DEPOSIT_TTL_MIN=60

# Пополнение USDT (в сети TON). Платёж опознаётся по уникальной сумме, комментарий не нужен
COINS_PER_USDT=100
MIN_DEPOSIT_USDT=1
MAX_DEPOSIT_USDT=5000

# Запасной курс, если рыночные источники недоступны (1 монета = 1 Star)
STAR_USD=0.015
TON_USD=

# Реферальная программа: процент от пополнений друга пригласившему (0 = выключено)
REF_PERCENT=5
